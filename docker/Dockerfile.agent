# BEACON COMPUTING INITIATIVE
# Developer Seal: CJB-DEV-2026
# Component: BCIBot Docker Image v0.4.1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends bash procps iproute2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /workspace
COPY nexus /app/nexus
CMD ["python3", "-m", "nexus.container_agent"]
